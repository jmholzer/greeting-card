# Copy this file to .env and adjust the values (the Prisma CLI reads .env).

# PostgreSQL connection strings. For a local database both can be the same URL.
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/greeting_card"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/greeting_card"

# Base URL of the running site, with no trailing slash.
HOST="http://localhost:3000"

# Optional: enables DELETE /api/admin/messages/<id> with "Authorization: Bearer <token>".
# Use a long random value (openssl rand -hex 32). Leave unset to disable the route.
# ADMIN_TOKEN=

# Optional: override the default card front. Use a path to a file in public/
# (e.g. /front.jpg) or an https URL. Only that exact URL is allowed for next/image.
# Set it before building, since it is read at build time.
# NEXT_PUBLIC_CARD_FRONT_URL="/front.jpg"

# Optional: page background colour (hex, colour name, or rgb()/hsl()). Default is #e66b1e.
# Read at build time.
# NEXT_PUBLIC_CARD_BACKGROUND_COLOR="#e66b1e"
